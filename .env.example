# Optional public settings. Set in Cloudflare Pages build variables or .env.local.
VITE_BUSINESS_ADDRESS=
VITE_SUPPORT_ALIAS=
VITE_GSC_VERIFICATION=
VITE_IOS_APP_STORE_URL=
VITE_GOOGLE_PLAY_URL=

# Leave blank for the same-origin Worker route at /api/*.
# Or set an HTTPS Worker origin (with an optional /api suffix) before npm run build.
VITE_API_BASE_URL=

# Local Vite proxies /api to http://127.0.0.1:8787 when VITE_API_BASE_URL is blank.
# Configure the separate Worker test variables and secrets in worker/.
